# Server
PORT=3000
NODE_ENV=production

# Public Toobit API base
TOOBIT_BASE_URL=https://api.toobit.com

# Trading account (keep these ONLY on the server; never put them in index.html)
TOOBIT_API_KEY=
TOOBIT_SECRET_KEY=

# Safety: live order routing is disabled unless BOTH flags are enabled.
ENABLE_LIVE_TRADING=false
ALLOW_LIVE_ORDERS=false

# Dashboard/API protection. Generate a long random value.
BOT_AUTH_TOKEN=change-this-to-a-long-random-token

# Strategy defaults
DEFAULT_MARGIN_USDT=1
DEFAULT_LEVERAGE=10
MIN_NET_EDGE_BPS=5
MIN_FUNDING_BPS=15
ENTRY_WINDOW_SEC=30
CLOSE_DELAY_MS=1
MAX_SPREAD_BPS=15
MAX_ADVERSE_MOVE_PCT=0.75
COOLDOWN_SEC=30
MAX_POSITION_NOTIONAL_USDT=50

# Fallback fee estimate used only before the per-symbol fee endpoint is fetched.
FALLBACK_TAKER_FEE=0.0006

# Data refresh cadence
FUNDING_REFRESH_MS=10000
SMART_DATA_REFRESH_MS=30000
